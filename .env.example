# RAG-TRACK Configuration Example
# Copy this file to .env and fill in your values
# Docker Compose automatically reads this file for variable substitution

# --- Application ---
# Environment: development (no secret validation) or production (strict validation)
ENVIRONMENT=development

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated origins) ---
# In Docker, include the container port for same-origin frontend serving
# When using Vite dev server, add port 5173; include both localhost and 127.0.0.1
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173,

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# --- File Upload ---
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,txt

# --- Chunking ---
CHUNK_SIZE=400
CHUNK_OVERLAP=100

# --- Embedding ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector Store ---
VECTOR_STORE_TYPE=faiss

# --- LLM (OpenRouter - cloud API, user-provided at runtime) ---
# The OpenRouter API key is NOT set here. Users enter it in the frontend UI.
# The key is validated via /auth/test-api-key (actual chat.completions call).
# The model name is also user-provided in the frontend.
# OPENROUTER_API_KEY is optional — only used as a fallback if the user doesn't provide one.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model used for fallback LLM calls (when user hasn't provided a model)
LLM_MODEL=google/gemma-4-26b-a4b-it:free

# --- Local LLM (Ollama - not yet integrated in container mode) ---
# The system will automatically use Ollama if OLLAMA_BASE_URL is set
# USE_LOCAL_LLM=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b

# --- Authentication ---
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-use-32-random-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API key for the RAG API itself (leave empty for dev mode — auth disabled)
API_KEY=

# --- Database ---
# For Docker Compose, the db service is at hostname "db"
DB_PASSWORD=ragtrack_password
DATABASE_URL=postgresql://ragtrack:ragtrack_password@localhost:5432/ragtrack

# --- Frontend Build ---
# URL the frontend uses to reach the API (set at build time)
VITE_API_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO
