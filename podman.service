[Unit]
Description=RAG-TRACK Container (API + PostgreSQL)
Documentation=https://github.com/YogeshChopade43/RAG-TRACK
After=podman.service network-online.target
Wants=podman.service network-online.target

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=%h/.env
ExecStartPre=/usr/bin/podman compose -f %h/RAG-TRACK/podman-compose.yml down 2>/dev/null || true
ExecStart=/usr/bin/podman compose -f %h/RAG-TRACK/podman-compose.yml up -d
ExecStop=/usr/bin/podman compose -f %h/RAG-TRACK/podman-compose.yml down
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
