# RAG-TRACK Podman Environment Configuration
# Copy this file to .env.podman and fill in your values
# Usage: export $(grep -v '^#' .env.podman | xargs) && podman compose -f podman-compose.yml up -d

# --- Container Registry ---
# Image registry for pulling base images
REGISTRY=registry.fedoraproject.org

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# --- File Upload ---
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,txt

# --- Chunking ---
CHUNK_SIZE=400
CHUNK_OVERLAP=100

# --- Embedding ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector Store ---
VECTOR_STORE_TYPE=faiss

# --- LLM (OpenRouter - cloud API) ---
# Set your OpenRouter API key for LLM access
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it:free

# --- Authentication ---
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-use-32-random-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DB_PASSWORD=ragtrack_password

# --- Build Arguments ---
VITE_API_URL=http://localhost:8000

# --- Podman-Specific ---
# Set to 1 to run containers rootless (recommended for development)
# Podman will prompt for sudo if running rootless and the pod needs network access
ROOTLESS=1
# Pod name for grouping db + api containers
POD_NAME=ragtrack-pod